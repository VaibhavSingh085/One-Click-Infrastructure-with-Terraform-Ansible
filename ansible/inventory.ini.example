# ansible/inventory.ini.example
#
# This file documents the format of the inventory generated by Terraform.
# The real ansible/inventory.ini is produced by 'make up' (terraform apply)
# and is excluded from version control via .gitignore.
#
# Do NOT copy this file to inventory.ini and commit it — it would expose
# your instance IP and key path.

[web]
web1 ansible_host=<EC2_PUBLIC_IP>

[web:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/terraform-demo
